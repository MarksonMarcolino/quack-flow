# quack-flow environment configuration
# Copy this file to .env and fill in your values.
# Never commit .env (it's gitignored).

# --- Required ---

# MotherDuck service token. Get one from https://app.motherduck.com/settings/tokens
# Airflow workers need this in their environment too (not just .env), since
# docker-compose passes it through to the Airflow containers.
MOTHERDUCK_TOKEN=

# Dev vs prod toggle. Drives the single switch in ml/db.py get_connection():
#   "dev"  -> local.duckdb
#   "prod" -> md:"quack-flow-db"
ENV=dev

# --- Airflow (kept for parity; unused in local launchd mode) ---

# Airflow REST API endpoint. In launchd mode this always points at localhost
# since docker-compose exposes Airflow on port 8080 locally.
AIRFLOW_HOST=http://localhost:8080
AIRFLOW_USER=airflow
AIRFLOW_PASS=airflow

# --- Optional overrides ---

# Ollama API endpoint. Override if you run Ollama on a non-default port
# or on another host on your local network.
OLLAMA_HOST=http://localhost:11434

# MLflow tracking directory. Relative paths are resolved against the
# project root. For a remote MLflow server, use http(s)://... instead.
MLFLOW_TRACKING_URI=./mlruns
